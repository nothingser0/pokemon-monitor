# Discord Webhook URL (untuk notifikasi)
WEBHOOK_URL=https://discord.com/api/webhooks/ISI_DI_SINI

# Bearer Token untuk autentikasi API
BEARER_TOKEN=ISI_BEARER_TOKEN_DI_SINI
