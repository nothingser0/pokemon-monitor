# ============================================================
# Pokemon GO Coordinate Monitor - Environment Variables (.env)
# ============================================================
# Salin file ini menjadi .env lalu sesuaikan nilainya:
#   cp .env.example .env

# Discord Webhook URL (untuk notifikasi)
WEBHOOK_URL=https://discord.com/api/webhooks/ISI_DI_SINI

# Bearer Token untuk autentikasi API
BEARER_TOKEN=ISI_BEARER_TOKEN_DI_SINI

# Interval pengecekan acak (dalam menit)
INTERVAL_MIN=30
INTERVAL_MAX=120
